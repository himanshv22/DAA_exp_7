
#include <iostream>
#include <vector>
#include <climits>
using namespace std;

struct Edge {
    int u, v, weight;
};

int main() {
    int V = 5, E = 8;

    vector<Edge> edges = {
        {0, 1, -1},
        {0, 2, 4},
        {1, 2, 3},
        {1, 3, 2},
        {1, 4, 2},
        {3, 2, 5},
        {3, 1, 1},
        {4, 3, -3}
    };

    int source = 0;

    vector<int> dist(V, INT_MAX);
    dist[source] = 0;

    // Relax all edges V-1 times
    for (int i = 1; i < V; i++) {
        for (const Edge &e : edges) {
            if (dist[e.u] != INT_MAX &&
                dist[e.u] + e.weight < dist[e.v]) {

                dist[e.v] = dist[e.u] + e.weight;
            }
        }
    }

    // Detect a reachable negative-weight cycle
    for (const Edge &e : edges) {
        if (dist[e.u] != INT_MAX &&
            dist[e.u] + e.weight < dist[e.v]) {

            cout << "Graph contains a negative-weight cycle."
                 << endl;

            return 0;
        }
    }

    // Print shortest distances
    cout << "Shortest distances from source vertex "
         << source << ":\n";

    for (int i = 0; i < V; i++) {
        cout << "Vertex " << i << ": ";

        if (dist[i] == INT_MAX)
            cout << "INF";
        else
            cout << dist[i];

        cout << endl;
    }

    return 0;
}
